# ==============================================================================
# Linux PREEMPT-RT + Raspbian Parity Configuration Fragment
# Target: Raspberry Pi 4 / Pi 5 (Ubuntu 24.04 Noble base)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Real-Time (PREEMPT_RT) Core Settings
# ------------------------------------------------------------------------------
CONFIG_PREEMPT_RT=y
CONFIG_NO_HZ_FULL=y
CONFIG_HZ_1000=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_IDLE=n
CONFIG_LOCKUP_DETECTOR=n
CONFIG_DETECT_HUNG_TASK=n
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_MODULES=y
CONFIG_KALLSYMS=y
CONFIG_TRACEPOINTS=y
CONFIG_EVENT_TRACING=y
CONFIG_PERF_EVENTS=y
CONFIG_DEBUG_INFO=n
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""

# ------------------------------------------------------------------------------
# 2. Industrial I/O (IIO) Subsystem & Sensors (LSM6DSX IMU, etc.)
# ------------------------------------------------------------------------------
CONFIG_IIO=m
CONFIG_IIO_BUFFER=y
CONFIG_IIO_KFIFO_BUF=m
CONFIG_IIO_TRIGGERED_BUFFER=m
CONFIG_IIO_SW_DEVICE=m
CONFIG_IIO_SW_TRIGGER=m

# STMicroelectronics LSM6DSx 6-Axis Accelerometer / Gyroscope
CONFIG_IIO_ST_LSM6DSX=m
CONFIG_IIO_ST_LSM6DSX_I2C=m
CONFIG_IIO_ST_LSM6DSX_SPI=m
CONFIG_IIO_ST_LSM6DSX_I3C=m

# ------------------------------------------------------------------------------
# 3. Raspbian Hardware & Peripheral Drivers Parity (Section 2.A)
# Drivers enabled in Raspbian bcm2711/bcm2712 defconfig but omitted/disabled in Ubuntu
# ------------------------------------------------------------------------------
# GPIO subsystem, expanders & multiplexers
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_STMPE=y
CONFIG_MUX_GPIO=m

# USB OTG controller (Pi Zero/4/5 OTG port and Gadget mode support)
CONFIG_USB_DWCOTG=y

# Camera & Media drivers (RPi Camera Module 3 autofocus, I2C video, AI HAT)
CONFIG_VIDEO_AK7375=m
CONFIG_VIDEO_I2C=m
CONFIG_MEDIA_PCI_SUPPORT=y
CONFIG_MEDIA_PCI_HAILO=m
CONFIG_STAGING_MEDIA_DEPRECATED=y

# Storage, Ethernet & PCIe interfaces
CONFIG_MMC_SDHCI_OF_DWCMSHC=m
CONFIG_R8169=m
CONFIG_XILLYBUS_PCIE=m

# ------------------------------------------------------------------------------
# 4. Debugging, Remote, Audio & Networking Parity (Section 2.B)
# ------------------------------------------------------------------------------
CONFIG_GENERIC_IRQ_DEBUGFS=y
CONFIG_BPF_LIRC_MODE2=y
CONFIG_SND_PCM_OSS=m
CONFIG_ROOT_NFS=y
CONFIG_NFSD_V2=y
CONFIG_NFSD_V2_ACL=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_XFRM_SUB_POLICY=y
CONFIG_VHOST_CROSS_ENDIAN_LEGACY=y

# ------------------------------------------------------------------------------
# 5. Built-in Boot & Core Driver Parity (Built-in '=y' in Raspbian vs '=m' in Ubuntu)
# Promotes key boot, bus, storage, and peripheral drivers directly into the kernel
# ------------------------------------------------------------------------------
# Android IPC & binder
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y

# Storage & NVMe (direct SSD boot)
CONFIG_BLK_DEV_NVME=y
CONFIG_BLK_DEV_RAM=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_F2FS_FS=y
CONFIG_AUTOFS_FS=y
CONFIG_NFS_FS=y
CONFIG_NFS_V4=y

# Pi Hardware controllers & SoC peripherals
CONFIG_PWM_RP1=y
CONFIG_PWM_BRCMSTB=y
CONFIG_LEDS_PWM=y
CONFIG_LEDS_TRIGGER_ACTPWR=y
CONFIG_LEDS_TRIGGER_INPUT=y
CONFIG_MMC_BCM2835_MMC=y
CONFIG_DW_AXI_DMAC=y
CONFIG_FB_BCM2708=y
CONFIG_USB_DWC3=y
CONFIG_USB_GADGET=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_PSTORE_RAM=y

# Networking hardware
CONFIG_MACB=y
CONFIG_MICREL_PHY=y
CONFIG_USB_RTL8152=y

# ------------------------------------------------------------------------------
# NOTE ON DELIBERATE DIFFERENCES FROM RASPBIAN (FOR REAL-TIME & COMPATIBILITY):
# 1. Page Size: Keeping Ubuntu default 4KB pages (CONFIG_ARM64_4K_PAGES=y)
#    instead of Raspbian Pi 5 16KB (CONFIG_ARM64_16K_PAGES=y) for ROS 2 package compatibility.
# 2. CPU Governor: Keeping PERFORMANCE governor (CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y)
#    instead of Raspbian POWERSAVE (CONFIG_CPU_FREQ_DEFAULT_GOV_POWERSAVE=y) to eliminate RT jitter.
# 3. PCIe ASPM: Keeping POWERSAVE disabled to prevent PCIe link sleep latency spikes.
# ------------------------------------------------------------------------------
