#!/bin/bash

set -e -o pipefail

pushd $CACHE_DIR

# Check for custom built kernel packages first
if ls custom_kernel_debs/linux-*.deb 1> /dev/null 2>&1; then
  echo "Found custom RT kernel deb packages in $CACHE_DIR/custom_kernel_debs/"
  cp custom_kernel_debs/linux-*.deb $CHROOT_PATH/setup/
  rm -f $CHROOT_PATH/setup/*dbg*.deb
elif [ -n "$CUSTOM_KERNEL_DEBS" ] && ls "$CUSTOM_KERNEL_DEBS"/linux-*.deb 1> /dev/null 2>&1; then
  echo "Found custom RT kernel deb packages in $CUSTOM_KERNEL_DEBS"
  cp "$CUSTOM_KERNEL_DEBS"/linux-*.deb $CHROOT_PATH/setup/
  rm -f $CHROOT_PATH/setup/*dbg*.deb
else
  # Get upstream pre-built kernel
  filename=rpi-rt-kernel-${LINUX_RT_VERSION}.zip
  if [ ! -f $filename ]; then
    wget --progress=dot -e dotbytes=10M -O $filename https://github.com/shuhaowu/rt-kernel-docker-builder/releases/download/6.8.4-r11/RPI4.RT.Kernel.deb.packages.zip
  fi

  unzip -o $filename

  rm -f *dbg*.deb # Remove the debug debian package as it is big.

  # These deb files will be installed by the phase1 script.
  # The /setup folder in the chroot is setup by the builder.
  cp linux-*.deb $CHROOT_PATH/setup/
  rm -f linux-*.deb
fi

popd
