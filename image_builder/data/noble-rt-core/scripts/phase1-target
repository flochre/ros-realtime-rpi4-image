#!/bin/bash

set -e -o pipefail

export DEBIAN_FRONTEND=noninteractive

# Setting up PREEMPT_RT kernel
cd /setup
dpkg -i linux-*.deb
rm linux-*.deb

# Ubuntu Core specific: Remove unnecessary packages that take space
echo "Cleaning up Ubuntu Core base packages..."
apt-get purge --autoremove -y \
  snapd \
  fwupd \
  mdadm \
  btrfs-progs \
  xfsprogs || true

# Ensure correct kernel symlinks for boot
echo "Setting up kernel boot symlinks..."
ln -s -f /boot/vmlinuz-${LINUX_RT_VERSION}-raspi /boot/vmlinuz
ln -s -f /boot/initrd.img-${LINUX_RT_VERSION}-raspi /boot/initrd.img

# Verify RT kernel is in place
if [ "$(md5sum /boot/vmlinuz-${LINUX_RT_VERSION}-raspi | cut -f 1 -d ' ')" = "$(md5sum /boot/vmlinuz | cut -f 1 -d ' ')" ]; then
  echo "✓ RT kernel successfully installed"
else
  echo "ERROR: RT kernel not properly installed"
  exit 1
fi

# Disable rt-throttling for real-time performance
echo "Configuring real-time kernel parameters..."
systemctl enable rt-throttling || true
systemctl enable memory-compaction || true

# Install Android kernel module dependencies
if [ "${ANDROID_MODULES_ENABLED}" = "1" ]; then
  echo "Installing Android kernel module dependencies..."
  
  # Update package lists
  apt-get update
  
  # Install essential build tools for kernel modules
  apt-get install -y \
    build-essential \
    linux-headers-${LINUX_RT_VERSION}-raspi \
    kmod \
    module-init-tools \
    dkms \
    || true
  
  # Install Android-related packages and libraries
  # Note: Not all Android packages are available in Ubuntu repos,
  # so we install what's available and provide placeholders for others
  apt-get install -y \
    android-sdk-platform-tools || true
  
  # Create directory structure for Android modules
  mkdir -p /lib/modules/${LINUX_RT_VERSION}-raspi/extra/android
  mkdir -p /opt/android-modules
  
  echo "✓ Android kernel module support infrastructure installed"
fi

# Install ROS 2 and other essential packages
echo "Installing ROS 2 and system packages..."
export ROS_DISTRO=jazzy
export ROS_APT_SOURCE_VERSION=$(curl -s https://api.github.com/repos/ros-infrastructure/ros-apt-source/releases/latest | grep -F "tag_name" | awk -F\" '{print $4}')
curl -L -o /tmp/ros2-apt-source.deb "https://github.com/ros-infrastructure/ros-apt-source/releases/download/${ROS_APT_SOURCE_VERSION}/ros2-apt-source_${ROS_APT_SOURCE_VERSION}.$(. /etc/os-release && echo $VERSION_CODENAME)_all.deb"
dpkg -i /tmp/ros2-apt-source.deb
rm /tmp/ros2-apt-source.deb

apt-get update
apt-get install -y \
  ros-${ROS_DISTRO}-ros-base \
  cpufrequtils \
  libraspberrypi-bin \
  rt-tests \
  cpuset \
  stress-ng \
  || true

# Disable automatic updates in Ubuntu Core
echo "Disabling unattended-upgrades..."
apt-get remove -y unattended-upgrades || true

# Clean up to reduce image size
echo "Cleaning up..."
apt-get clean
rm -rf /var/lib/apt/lists/*

echo "✓ Ubuntu Core RT with Android module support configured"
