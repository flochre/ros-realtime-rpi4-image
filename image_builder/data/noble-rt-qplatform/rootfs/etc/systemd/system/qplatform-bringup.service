[Unit]
Description=QPlatform Omni Robot Bringup (ros2_control + IIO IMU + EKF + Nav2)
After=network-online.target micro-ros-agent.service
Wants=network-online.target micro-ros-agent.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
SupplementaryGroups=iio video render input tty seat
Environment="HOME=/home/ubuntu"
Environment="ROS_DOMAIN_ID=0"
ExecStart=/bin/bash -c "source /opt/ros/jazzy/setup.bash && [ -f /opt/qplatform/ros2_ws/install/setup.bash ] && source /opt/qplatform/ros2_ws/install/setup.bash; exec ros2 launch /opt/qplatform/launch/omni_bringup.launch.py"
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
