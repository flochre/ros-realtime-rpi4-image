    </link>
    <joint name="groupe_2_fastened_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 -0 0" />
        <axis xyz="-0 -0 -1" />
        <parent link="base_roulante_assemblage_v11_1__1_" />
        <child link="assembly_1__1_" />
    </joint>
    <joint name="groupe_2_fastened_joint_1" type="fixed">
        <origin xyz="0.0225524 -0.00345593 0.073" rpy="3.14159 1.45461e-15 -1.5708" />
        <axis xyz="-0 -0 -1" />
        <parent link="mainboard_assembled_v1_1__1_" />
        <child link="base_roulante_assemblage_v11_1__1_" />
    </joint>
    <joint name="hanging_node_to_root_joint" type="fixed">
        <origin xyz="0.00025 0.16862 0.0265" rpy="0 -0 0" />
        <axis xyz="0 0 1" />
        <parent link="root" />
        <child link="kfl08___mancal_flange_oval_Ø8_v1_1__corps2_1" />
    </joint>
    <joint name="hanging_node_to_root_joint_1" type="fixed">
        <origin xyz="0.145904 -0.0845263 0.0265" rpy="0 0 -2.0944" />
        <axis xyz="0 0 1" />
        <parent link="root" />
        <child link="kfl08___mancal_flange_oval_Ø8_v1_1__corps2_5" />
    </joint>
    <joint name="hanging_node_to_root_joint_2" type="fixed">
        <origin xyz="-0.00345593 0.0225524 0.073" rpy="3.14159 1.4326e-12 -1.5708" />
        <axis xyz="0 0 1" />
        <parent link="root" />
        <child link="mainboard_assembled_v1_1__1_" />
    </joint>
    <joint name="hanging_node_to_root_joint_3" type="fixed">
        <origin xyz="-0.161612 -0.0930183 0.0265" rpy="0 -1.5708 2.0944" />
        <axis xyz="0 0 1" />
        <parent link="root" />
        <child link="hub_1__corps1" />
    </joint>
    <joint name="pivot_1" type="continuous">
        <origin xyz="3.95734e-18 0.01135 -2.08167e-17" rpy="-3.14159 1.07952e-78 3.14159" />
        <axis xyz="0 -1 0" />
        <parent link="kfl08___mancal_flange_oval_Ø8_v1_1__corps2_1" />
