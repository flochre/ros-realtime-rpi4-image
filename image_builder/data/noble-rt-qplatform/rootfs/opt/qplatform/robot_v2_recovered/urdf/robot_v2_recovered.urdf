    <!-- Standard ROS base_link and imu_link frames -->
    <link name="base_link" />
    <joint name="base_to_root_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="root" />
    </joint>

    <link name="imu_link" />
    <joint name="base_to_imu_joint" type="fixed">
        <origin xyz="0 0 0.073" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="imu_link" />
    </joint>

    <!-- ros2_control system definition for 3-wheel omni drive (bound to 3 STM32H563 micro-ROS stepper nodes) -->
    <ros2_control name="QPlatformOmniSystem" type="system">
        <hardware>
            <plugin>qplatform_hardware/QPlatformStepperSystem</plugin>
            <!-- 200 full steps/rev * 256 microsteps (TMC2160 mres=0) = 51200 microsteps/motor rev -->
            <param name="steps_per_rev">51200.0</param>
            <!-- Belt pulley reduction (e.g. 118/36 = 3.2777778, or 1.0 if direct) -->
            <param name="gear_ratio">3.2777778</param>
            <!-- false = use /position (Int32 microsteps), true = use unwrapped MT6816 /angle (Float32 deg) -->
            <param name="use_encoder_angle">false</param>
            <param name="open_loop_fallback">true</param>
            <!-- STM32 micro-ROS /set_parameters configuration -->
            <param name="deadband_steps">4</param>
            <param name="command_timeout_ms">500</param>
            <param name="enable_maixsense">true</param>
        </hardware>
        <!--
          Per-motor topic_prefix maps each wheel joint to its STM32H563 micro-ROS topics:
            <topic_prefix>/cmd_pos   (std_msgs/msg/Int32)   - Stepper target position [microsteps]
            <topic_prefix>/position  (std_msgs/msg/Int32)   - Stepper actual position [microsteps]
            <topic_prefix>/angle     (std_msgs/msg/Float32) - MT6816 encoder angle [0..360 deg]
          Adjust topic_prefix (e.g. /motor_1, /motor_2, /motor_3 or /motor_0442626A, /motor_0458626B, /motor_046F6260)
          to match the namespace configured in the STM32 firmware.
        -->
        <joint name="pivot_1">
            <param name="topic_prefix">/motor_42626A</param>
            <param name="invert_direction">false</param>
            <command_interface name="velocity" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
        <joint name="pivot_2">
            <param name="topic_prefix">/motor_58626B</param>
            <param name="invert_direction">false</param>
            <command_interface name="velocity" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
        <joint name="pivot_3">
            <param name="topic_prefix">/motor_6F6260</param>
            <param name="invert_direction">false</param>
            <command_interface name="velocity" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
    </ros2_control>
</robot>

